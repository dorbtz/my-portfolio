# ===== Supabase (required) =====
# Client-readable (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_anon_key

# Server-only (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ===== Vercel AI Gateway (required from M5 onward) =====
# Single key routes anthropic/openai/google/groq via "provider/model" strings
AI_GATEWAY_API_KEY=your_gateway_key

# ===== Resend (required from M7 onward; SMTP for Supabase auth) =====
RESEND_API_KEY=your_resend_key

# ===== Vercel observability (required from M7 onward; powers /admin/health) =====
VERCEL_API_TOKEN=your_vercel_token

# ===== Cron auth (required from M5 onward) =====
# Bearer used by Vercel Cron to call protected /api/cron/* endpoints
CRON_SECRET=generate_a_long_random_string

# ===== Portfolio identity (defaults) =====
NEXT_PUBLIC_SITE_URL=https://dorbtz.com
NEXT_PUBLIC_PORTFOLIO_NAME="Dor Ben Tzur"
NEXT_PUBLIC_PORTFOLIO_TITLE="Full-Stack & AI Engineer"
