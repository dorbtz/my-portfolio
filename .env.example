# ===== Supabase (required) =====
VITE_SUPABASE_URL=https://yourproject.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_anon_key

# ===== Portfolio identity =====
# Display name shown in header wordmark, footer, and accessibility labels.
# Word boundaries drive the hidden D-B-T admin entry sequence.
VITE_PORTFOLIO_NAME="Your Name Here"
VITE_PORTFOLIO_TITLE="Your Title — e.g. AI Engineer · Frontend Artisan"
VITE_PORTFOLIO_BIO="One short sentence about you for the footer."
VITE_PORTFOLIO_TAGLINE="One-line meta description for SEO + OG tags."

# Social links (leave blank to hide the icon)
VITE_PORTFOLIO_GITHUB_URL=https://github.com/yourhandle
VITE_PORTFOLIO_LINKEDIN_URL=https://www.linkedin.com/in/yourhandle/

# ===== GitHub stats badge (optional) =====
VITE_GITHUB_USER=yourhandle
VITE_GITHUB_BADGE_MODE=live   # live | static | off
