{
  "name": "my-portfolio",
  "private": false,
  "version": "1.0.0",
  "description": "Dual-mode (Thor / Luffy Gear 5) portfolio with a Supabase-backed CMS, comic-book design system, and admin dashboard. React 19 + Vite + Tailwind v4.",
  "license": "MIT",
  "author": "Dor Ben Tzur",
  "repository": {
    "type": "git",
    "url": "https://github.com/dorbtz/my-portfolio.git"
  },
  "homepage": "https://github.com/dorbtz/my-portfolio#readme",
  "keywords": [
    "portfolio",
    "react",
    "vite",
    "tailwind",
    "supabase",
    "typescript",
    "gsap",
    "marvel",
    "one-piece",
    "comic-book",
    "dual-mode",
    "admin-cms"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:models": "node scripts/optimize-models.mjs",
    "build:assets": "node scripts/optimize-luffy-assets.mjs",
    "download:islands": "node scripts/download-islands.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.75.0",
    "@tailwindcss/vite": "^4.1.14",
    "d3-hierarchy": "^3.1.2",
    "d3-shape": "^3.2.0",
    "fuse.js": "^7.1.0",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "lenis": "^1.3.23",
    "motion": "^12.38.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@gltf-transform/cli": "^4.3.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-shape": "^3.1.8",
    "@types/howler": "^2.2.12",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "npm:rolldown-vite@7.1.14",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  }
}
